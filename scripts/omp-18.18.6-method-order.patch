diff --git a/packages/coding-agent/test/modes/components/settings-selector-triage.test.ts b/packages/coding-agent/test/modes/components/settings-selector-triage.test.ts
new file mode 100644
index 0000000..2e4b3db
--- /dev/null
+++ b/packages/coding-agent/test/modes/components/settings-selector-triage.test.ts
@@ -0,0 +1,44 @@
+import { afterEach, beforeAll, expect, test } from "bun:test";
+import { resetSettingsForTest, Settings, settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { createSettingsHost } from "@oh-my-pi/pi-coding-agent/config/settings-ui";
+import { createPluginSettingsHost } from "@oh-my-pi/pi-coding-agent/extensibility/plugins/settings-host";
+import { cfgCompactionMethodOrder } from "@oh-my-pi/pi-coding-agent/session/context-settings";
+import { SettingsSelectorComponent } from "@oh-my-pi/pi-tui/overlays/settings-selector";
+import { initTheme } from "@oh-my-pi/pi-tui/theme";
+
+beforeAll(async () => {
+	await initTheme();
+});
+afterEach(() => {
+	resetSettingsForTest();
+});
+
+test("Compaction Method Order can enable triage, move it first, and retain the order when reopened", async () => {
+	resetSettingsForTest();
+	await Settings.init({ inMemory: true });
+	cfgCompactionMethodOrder.set(settings, ["soft", "remote"]);
+	const createSelector = () =>
+		new SettingsSelectorComponent(
+			{
+				availableThinkingLevels: [],
+				thinkingLevel: undefined,
+				availableThemes: ["dark"],
+				providers: [],
+				settings: createSettingsHost(),
+				plugins: createPluginSettingsHost(process.cwd()),
+			},
+			{ onChange: () => {}, onCancel: () => {} },
+		);
+	const selector = createSelector();
+	for (const ch of "compaction method order") selector.handleInput(ch);
+	selector.render(120);
+	selector.handleInput("\n");
+	expect(selector.render(120).join("\n")).toContain("Knowledge triage");
+	selector.handleInput(" ");
+	selector.handleInput("1");
+	selector.handleInput("\x1b");
+	expect(cfgCompactionMethodOrder.get(settings)).toEqual(["knowledge-triage", "soft", "remote"]);
+	const reopened = createSelector();
+	for (const ch of "compaction method order") reopened.handleInput(ch);
+	expect(reopened.render(120).join("\n")).toContain("Knowledge triage");
+});
