diff --git a/packages/coding-agent/test/title-model-isolation.test.ts b/packages/coding-agent/test/title-model-isolation.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/test/title-model-isolation.test.ts
@@ -0,0 +1,131 @@
+import { afterEach, describe, expect, it, vi } from "bun:test";
+import * as ai from "@oh-my-pi/pi-ai";
+import { buildModel } from "@oh-my-pi/pi-catalog/build";
+import type { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { generateSessionTitle, generateTitleOnline } from "@oh-my-pi/pi-coding-agent/utils/title-generator";
+import { createAssistantMessage } from "./helpers/agent-session-setup";
+
+const titleModel = buildModel({
+	id: "title:1b",
+	name: "Title model",
+	provider: "title-server",
+	api: "openai-completions",
+	baseUrl: "http://127.0.0.1:52625/v1",
+	reasoning: false,
+	input: ["text"],
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+	contextWindow: 8192,
+	maxTokens: 1024,
+});
+const mainModel = buildModel({ ...titleModel, compat: {}, provider: "main-server", id: "main" });
+const titleSelector = `${titleModel.provider}/${titleModel.id}`;
+const mainSelector = `${mainModel.provider}/${mainModel.id}`;
+const registry = {
+	getAvailable: () => [titleModel, mainModel],
+	getApiKey: async () => "test-key",
+	resolver: () => async () => "test-key",
+} as unknown as ModelRegistry;
+
+function settings(tiny: string | undefined = titleSelector): Settings {
+	return Settings.isolated({
+		modelRoles: { ...(tiny ? { tiny } : {}), commit: mainSelector, smol: mainSelector },
+		"title.modelFallback": false,
+		"retry.modelFallback": true,
+		"retry.fallbackChains": { tiny: [mainSelector], [titleSelector]: [mainSelector] },
+	});
+}
+
+afterEach(() => vi.restoreAllMocks());
+
+describe("isolated title model", () => {
+	it("uses the exact configured model, including a colon in its id", async () => {
+		const complete = vi
+			.spyOn(ai, "completeSimple")
+			.mockResolvedValue(createAssistantMessage("<title>Fix cache reuse</title>"));
+		const title = await generateSessionTitle("Fix repeated cache misses", registry, settings(), undefined, mainModel);
+		expect(title).toBe("Fix cache reuse");
+		expect(complete.mock.calls.map(call => call[0])).toEqual([titleModel]);
+	});
+
+	it.each(["", "title-server/missing", "title", "@smol"])(
+		"skips titles for unresolved selector %j without choosing the main model",
+		async selector => {
+			const complete = vi
+				.spyOn(ai, "completeSimple")
+				.mockResolvedValue(createAssistantMessage("<title>Unexpected fallback</title>"));
+			expect(
+				await generateSessionTitle("Fix repeated cache misses", registry, settings(selector), undefined, mainModel),
+			).toBeNull();
+			expect(complete).not.toHaveBeenCalled();
+		},
+	);
+
+	it.each([generateSessionTitle, generateTitleOnline])(
+		"prevents provider and role fallback through %p",
+		async generate => {
+			const complete = vi.spyOn(ai, "completeSimple").mockResolvedValue({
+				...createAssistantMessage(""),
+				stopReason: "error",
+				errorStatus: 400,
+				errorMessage: "Title model unavailable",
+			});
+			expect(await generate("Fix repeated cache misses", registry, settings(), undefined, mainModel)).toBeNull();
+			expect(complete.mock.calls.map(call => call[0])).toEqual([titleModel]);
+		},
+	);
+
+	it("does not fall back when the title server produces no visible title", async () => {
+		const complete = vi.spyOn(ai, "completeSimple").mockResolvedValue(createAssistantMessage("<title/>"));
+		expect(
+			await generateSessionTitle("Fix repeated cache misses", registry, settings(), undefined, mainModel),
+		).toBeNull();
+		expect(complete.mock.calls.map(call => call[0])).toEqual([titleModel]);
+	});
+
+	it("retries transient failures on the same title model", async () => {
+		const complete = vi
+			.spyOn(ai, "completeSimple")
+			.mockResolvedValueOnce({
+				...createAssistantMessage(""),
+				stopReason: "error",
+				errorStatus: 503,
+				errorMessage: "Service unavailable",
+			})
+			.mockResolvedValue(createAssistantMessage("<title>Fix cache reuse</title>"));
+		expect(await generateSessionTitle("Fix repeated cache misses", registry, settings(), undefined, mainModel)).toBe(
+			"Fix cache reuse",
+		);
+		expect(complete.mock.calls.map(call => call[0])).toEqual([titleModel, titleModel]);
+	});
+
+	it("does not send a title to the main model after a connection failure", async () => {
+		const complete = vi.spyOn(ai, "completeSimple").mockRejectedValue(new Error("ECONNREFUSED"));
+		expect(
+			await generateSessionTitle("Fix repeated cache misses", registry, settings(), undefined, mainModel),
+		).toBeNull();
+		expect(complete.mock.calls.map(call => call[0])).toEqual([titleModel]);
+	}, 10_000);
+
+	it("stops title retries when the session title deadline expires", async () => {
+		const signal = AbortSignal.timeout(20);
+		const complete = vi.spyOn(ai, "completeSimple").mockImplementation(async () => {
+			await Bun.sleep(40);
+			return { ...createAssistantMessage(""), stopReason: "aborted" };
+		});
+		expect(
+			await generateSessionTitle(
+				"Fix repeated cache misses",
+				registry,
+				settings(),
+				undefined,
+				mainModel,
+				undefined,
+				undefined,
+				signal,
+			),
+		).toBeNull();
+		expect(signal.aborted).toBe(true);
+		expect(complete.mock.calls.map(call => call[0])).toEqual([titleModel]);
+	});
+});
